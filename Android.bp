android_app_import {
    name: "AxionFx",
    apk: "AxionFx.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    overrides: ["AudioFX"],
    required: [
        "privapp-permissions-axionfx",
        "libaxionfxaidl",
        "libaxionfx_legacy",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-axionfx",
    sub_dir: "permissions",
    src: "privapp-permissions-axionfx.xml",
    filename_from_src: true,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libaxionfxaidl",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "lib64/soundfx/libaxionfxaidl.so",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libaxionfx_legacy",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "lib64/soundfx/libaxionfx_legacy.so",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
    check_elf_files: false,
}
